# Reproducible Linux CUDA 12.4 container specification for OCG 3D ENGINE (TRELLIS.2-4B)
# CANDIDATE SPECIFICATION — NOT BUILT OR ACTIVATED WITHOUT FOUNDER AUTHORIZATION
# Installs microsoft/TRELLIS.2 at pinned revision 75fbf0183001ed9876c8dbb35de6b68552ee08bd.
# Does NOT download gated model weights (DINOv3 / TRELLIS.2-4B) at build time.

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ARG TRELLIS2_REPO=https://github.com/microsoft/TRELLIS.2.git
ARG TRELLIS2_COMMIT=75fbf0183001ed9876c8dbb35de6b68552ee08bd

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/trellis2 \
    TORCH_CUDA_ARCH_LIST="8.9" \
    OCG_PYTHON_BIN=python3.10 \
    OCG_TRELLIS_WORKER_PATH=/app/infra/trellis2/trellis2_worker.py \
    OCG_BG_REMOVER=u2net \
    OCG_DINOV3_ATTRIBUTION="Built with DINOv3" \
    NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-dev python3-pip python3-venv curl ca-certificates git build-essential ninja-build \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --no-checkout "${TRELLIS2_REPO}" /opt/trellis2 \
    && git -C /opt/trellis2 checkout "${TRELLIS2_COMMIT}" \
    && git -C /opt/trellis2 submodule update --init --recursive --depth 1

WORKDIR /app
COPY package.json ./
COPY lib ./lib
COPY src ./src
COPY assets ./assets
COPY infra/trellis2/requirements.trellis2.txt ./infra/trellis2/requirements.trellis2.txt
COPY infra/trellis2/trellis2_worker.py ./infra/trellis2/trellis2_worker.py

RUN python3.10 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3.10 -m pip install --no-cache-dir -r ./infra/trellis2/requirements.trellis2.txt

RUN if [ -d /opt/trellis2/o-voxel ]; then python3.10 -m pip install --no-cache-dir --no-deps --no-build-isolation /opt/trellis2/o-voxel; fi

RUN useradd --create-home --shell /bin/bash ocg && chown -R ocg:ocg /app /opt/trellis2
USER ocg

EXPOSE 8788
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8788/health || exit 1
CMD ["node", "src/asset3dMain.mjs"]
